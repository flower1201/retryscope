{
  "name": "retryscope",
  "version": "0.1.0-dev.0",
  "description": "Find out where your AI coding agent got stuck.",
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "retryscope": "node ./dist/cli/index.js",
    "demo": "npm run build && node ./dist/cli/index.js analyze ./examples/synthetic-session.jsonl --out ./examples/out-demo"
  },
  "keywords": [
    "claude-code",
    "cli",
    "retry",
    "agent",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "retryscope": "./dist/cli/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples/synthetic-session.jsonl",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.56.1",
    "tsup": "^8.5.1",
    "typescript": "~5.7.3",
    "vitest": "^5.0.3"
  }
}
